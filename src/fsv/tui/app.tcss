Screen {
    layout: vertical;
    background: transparent;
}

Vertical, VerticalScroll, Static {
    background: transparent;
    scrollbar-size: 1 1;
}

DataTable {
    background: transparent;
    scrollbar-size: 1 1;
}

DataTable > .datatable--header {
    background: transparent;
}

DataTable > .datatable--even-row {
    background: transparent;
}

#header {
    dock: top;
    height: 1;
    padding: 0 1;
}

#main {
    height: 1fr;
}

#list-pane {
    height: 11fr;
    min-height: 8;
    border-bottom: heavy $surface;
}

#list-pane:focus-within {
    border-bottom: heavy $success;
}

#list {
    height: 1fr;
    min-height: 4;
}


#filter-input {
    height: 1;
    border: none;
    padding: 0 1;
    background: transparent;
}

#filter-input:focus {
    border: none;
}

#search-input {
    height: 1;
    border: none;
    padding: 0 1;
    background: transparent;
}

#search-input:focus {
    border: none;
}

#suggestion-bar {
    height: 1;
    padding: 0 1;
    background: transparent;
}

#filter-bar {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

#detail {
    height: 9fr;
    min-height: 8;
    border-top: heavy $surface;
}

#detail:focus-within {
    border-top: heavy $success;
}

#detail-bar {
    height: 1;
    padding: 0 1;
}

#state-flow-bar {
    height: 1;
    padding: 0 1;
}

#detail-tabs {
    height: 1;
    padding: 0 1;
}

#detail-scroll {
    height: 1fr;
    padding: 0 1;
}

#detail-content {
    padding: 0;
}

#status-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
}

#key-hints {
    dock: bottom;
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

.tab-active {
    background: $accent;
    color: $text;
    text-style: bold;
}

/* ── Modals (theme variables so they work on light and dark) ── */

StatusScreen, ConfirmScreen, NoteScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: heavy $accent;
    background: $surface;
    color: $text;
}

.dialog Static {
    background: transparent;
}

.dialog-title {
    margin-bottom: 1;
}

.dialog-hint {
    margin-top: 1;
    color: $text-muted;
}

.dialog-buttons {
    height: auto;
    margin-top: 1;
}

.dialog-buttons Button {
    margin-right: 2;
}

#status-options {
    height: auto;
    max-height: 16;
    border: none;
    background: $panel;
}

#note-text {
    height: 8;
    border: tall $primary;
}

#note-visibility, #note-preview {
    margin-top: 1;
    height: auto;
    max-height: 6;
}

#confirm-body {
    height: auto;
}

.dialog Button {
    min-width: 14;
    background: $panel;
    color: $text;
    border: tall $primary;
    text-style: bold;
}

.dialog Button:focus {
    background: $primary;
    color: $background;
}

.dialog Button.-warning {
    border: tall $warning;
}

.dialog Button.-warning:focus {
    background: $warning;
    color: $background;
}
